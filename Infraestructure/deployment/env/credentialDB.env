# ============================================================
# IMÁGENES DOCKER
# ============================================================

POSTGRES_IMAGE=postgres:17.7-alpine3.23
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:latest


# ============================================================
# RED COMPARTIDA
# ============================================================

SISVE_NETWORK_NAME=sisve-network


# ============================================================
# AUTH SERVICE - BASE DE DATOS
# ============================================================

AUTH_DB_NAME=sisve_auth
AUTH_DB_USERNAME=auth_app_user
AUTH_DB_PASSWORD=auth_password_local_2026

# Puerto para acceder desde Windows:
# localhost:54321
AUTH_DB_HOST_PORT=54321

# Nombre del volumen persistente
AUTH_DB_VOLUME_NAME=sisve-auth-postgres-data


# ============================================================
# AUTH DATABASE - POSTGRES EXPORTER
# ============================================================

# Endpoint desde Windows:
# http://localhost:9187/metrics
AUTH_POSTGRES_EXPORTER_HOST_PORT=9187


# ============================================================
# AUDIT SERVICE - BASE DE DATOS
# ============================================================

AUDIT_DB_NAME=sisve_audit
AUDIT_DB_USERNAME=audit_app_user
AUDIT_DB_PASSWORD=audit_password_local_2026

# Puerto para acceder desde Windows:
# localhost:54322
AUDIT_DB_HOST_PORT=54322

# Nombre del volumen persistente
AUDIT_DB_VOLUME_NAME=sisve-audit-postgres-data


# ============================================================
# AUDIT DATABASE - POSTGRES EXPORTER
# ============================================================

# Endpoint desde Windows:
# http://localhost:9188/metrics
AUDIT_POSTGRES_EXPORTER_HOST_PORT=9188
